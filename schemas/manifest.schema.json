{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Local snapshot manifest",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "episode_id",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "episode_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "object",
      "required": [
        "episode.yaml",
        "script.md"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "size"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
